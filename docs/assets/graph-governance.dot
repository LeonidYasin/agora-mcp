digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.4", ranksep="0.65", splines=polyline];
node [shape=box, style="rounded,filled", fontname="Arial", fontsize=16, margin="0.2,0.15", color="#E6E5E3", fontcolor="#2C2C2B"];
edge [fontname="Arial", fontsize=13, color="#7D7A75", fontcolor="#55534F", arrowsize=0.7];
"constitution" [label="Правила и права\n[план]", fillcolor="#FBEBDE"];
"parliament" [label="Парламент\n[план]", fillcolor="#FBEBDE"];
"electoral" [label="Избирательные органы\n[план]", fillcolor="#FBEBDE"];
"courts" [label="Суды\n[план]", fillcolor="#FBEBDE"];
"appeals" [label="Апелляции / гарантии\n[план]", fillcolor="#FBEBDE"];
"mandates" [label="Полномочия / мандаты\n[план]", fillcolor="#FBEBDE"];
"audit" [label="Аудит / приватность\n[план]", fillcolor="#FBEBDE"];
"republic" [label="Республика\n[план]", fillcolor="#FBEBDE"];
"republic" -> "constitution" [label="основание", style=dashed];
"constitution" -> "parliament" [label="законодательство", style=dashed];
"constitution" -> "electoral" [label="выборы", style=dashed];
"constitution" -> "courts" [label="разбирательства", style=dashed];
"parliament" -> "mandates" [label="границы", style=dashed];
"electoral" -> "mandates" [label="мандаты", style=dashed];
"courts" -> "appeals" [label="пересмотр", style=dashed];
"mandates" -> "audit" [label="подотчётность", style=dashed];
"appeals" -> "audit" [label="процедуры / данные", style=dashed];
}
