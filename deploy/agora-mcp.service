[Unit]
Description=Agora MCP discovery server
After=network.target

[Service]
Type=simple
User=agora
Group=agora
WorkingDirectory=/home/agora/agora-mcp/mcp-server
EnvironmentFile=/etc/agora-mcp/agora.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077

[Install]
WantedBy=multi-user.target
