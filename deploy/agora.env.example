# Template only: copy OUTSIDE the repo, replace placeholders, keep root-owned 0600.
# This is systemd EnvironmentFile syntax, not a shell script (no export commands).
NODE_ENV=production
HOST=127.0.0.1
PORT=3011
DATABASE_URL=postgres://agora:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/agora
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_BASE_URL=http://127.0.0.1:11434

# Public URL clients use, without a trailing slash. Required for MCP OAuth.
# Manual bearer tokens continue to work when this is unset.
AGORA_PUBLIC_BASE_URL=https://leonid-mcp.duckdns.org/agora
# Google OAuth client. Register redirect URI ${AGORA_PUBLIC_BASE_URL}/oauth/google/callback.
# Leave unset to keep the manual-token market running without browser login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
