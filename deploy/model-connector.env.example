# Example only; DO NOT apply automatically. systemd EnvironmentFile, not shell.
# Keep DATABASE_URL/HOST/PORT in the existing private file. No real keys in Git.
# Choose models offered by YOUR configured endpoint/gateway, not these placeholders.
# Paid API is allowed; no automatic subscription, retry or provider fallback.
EMBEDDING_PROVIDER=litellm
EMBEDDING_BASE_URL=http://127.0.0.1:4000/v1
EMBEDDING_MODEL=agora-embedding-alias
EMBEDDING_API_KEY=REPLACE_PRIVATELY_WITH_GATEWAY_KEY
# Existing database requires a 1024-dimensional embedding model AND reindexing on model change.
# Optional chat capability; not called by current MCP tools.
LLM_PROVIDER=litellm
LLM_BASE_URL=http://127.0.0.1:4000/v1
LLM_MODEL=agora-chat-alias
LLM_API_KEY=REPLACE_PRIVATELY_WITH_GATEWAY_KEY
LLM_TOKEN_FIELD=max_tokens
# No gateway is installed or started by this template.
